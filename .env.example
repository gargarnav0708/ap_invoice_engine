# ==============================================================================
# AP Invoice Processing Engine - Configuration
# ==============================================================================

# AI Extraction Configuration (Groq)
# Leave blank to run in Demo / Test mode with synthetic fixtures and smart heuristics
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_COMPLETION_TOKENS=8192
LLM_RETRY_MAX_COMPLETION_TOKENS=16384
LLM_REASONING_EFFORT=low
# Live mode is used only when LLM_API_KEY is configured; otherwise it falls back to demo.
EXTRACTION_MODE=live

# Database Configuration (Persistent SQLite by default)
DATABASE_URL=sqlite:///data/ap_invoices.db

# Storage Directories
STORAGE_DIR=data/uploads
SAMPLE_DATA_DIR=data/sample_data

# OCR Engine Configuration
OCR_ENABLED=true
TESSERACT_CMD=

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_DEMO_MODE=true
