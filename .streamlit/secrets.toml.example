# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# "Secrets" box for the deployed app. Leave blank to run the deterministic
# demo extractor (no network calls). Provide a key to use live LLM extraction.
LLM_API_KEY = ""
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_MODEL = "gpt-4o-mini"
